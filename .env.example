# TraceForge development environment template.
# Copy to .env and adjust. NEVER commit a populated .env (see .gitignore).

# --- runtime ---------------------------------------------------------------
TF_ENVIRONMENT=development          # development | production
TF_LOG_LEVEL=INFO

# --- OpenTelemetry trace export --------------------------------------------
TF_OTEL_EXPORT_ENABLED=true
TF_OTEL_EXPORTER_PROTOCOL=http/protobuf
TF_OTEL_EXPORTER_ENDPOINT=http://otel-collector:4318/v1/traces
TF_OTEL_EXPORT_TIMEOUT_MS=5000
TF_OTEL_SCHEDULE_DELAY_MS=500

# --- latency detection ------------------------------------------------------
TF_LATENCY_THRESHOLD_MS=1000        # static threshold used by the detector

# --- demo fault injection (dev only; forced off in production) --------------
TF_FAULT_INJECTION_ENABLED=true
TF_SLOW_DELAY_MS=1500

# --- service URLs (inside the Docker Compose network) -----------------------
TF_ORDER_URL=http://order-service:8000
TF_INVENTORY_URL=http://inventory-service:8000
